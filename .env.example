# PostgreSQL, required for admin content and contact storage
DATABASE_URL=
# Generate with: openssl rand -hex 32 (at least 32 characters)
SESSION_SECRET=
# Administrator email; password hash generated with README command
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Public canonical origin, HTTPS in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional Resend integration: only enable with verified sender
RESEND_API_KEY=
NOTIFICATION_FROM=
NOTIFICATION_TO=
